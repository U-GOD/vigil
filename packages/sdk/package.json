{
  "name": "@vigil/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chain": {
      "development": {
        "types": "./src/chain.ts",
        "import": "./src/chain.ts"
      },
      "types": "./dist/chain.d.ts",
      "import": "./dist/chain.js"
    },
    "./math": {
      "development": {
        "types": "./src/closureMath.ts",
        "import": "./src/closureMath.ts"
      },
      "types": "./dist/closureMath.d.ts",
      "import": "./dist/closureMath.js"
    },
    "./policy": {
      "development": {
        "types": "./src/policy.ts",
        "import": "./src/policy.ts"
      },
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:vectors": "node scripts/genSplitVectors.mjs",
    "gen:sessions": "node scripts/genSessions.mjs"
  },
  "dependencies": {
    "@toxicflow-labs/ts-sdk": "0.1.1",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
